<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; everything visible is Compose (OpenCodeTheme). -->
    <style name="Theme.OpenCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <style name="Theme.OpenCode.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenCode</item>
    </style>
</resources>
